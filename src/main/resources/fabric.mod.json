{
  "schemaVersion": 1,
  "id": "mtrliftcolornew",
  "version": "${version}",
  "icon": "assets/mtrliftcolornew/textures/icon.png",
  "name": "新·MTR电梯染色模组",
  "description": "给 MTR 电梯轿厢内部屏幕染色，支持分梯配，并提供电梯调色面板与图形化积木式「自动化」规则（测试功能，支持导出/导入；配色与自动化按梯分文件存储，导出为自动化配置一梯一文件）支持单人、局域网与专用服务器（服务器与玩家都需安装本模组，配置由服务器保存并同步）。兼容 MTR 4.0.3-4.0.5，Fabric 1.20.1。",
  "authors": [
    "xiao"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.xiao.mtrliftcolornew.MTRLiftColorMod"
    ],
    "client": [
      "com.xiao.mtrliftcolornew.client.MTRLiftColorClient"
    ],
    "server": [
      "com.xiao.mtrliftcolornew.MTRLiftColorServer"
    ]
  },
  "mixins": [
    "mtrliftcolornew.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
     "mtr": ">=4.0.3"
  }
}
