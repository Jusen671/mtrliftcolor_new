name: Delete All Files

on:
  workflow_dispatch: # 手动触发，防止误删
  # 你也可以改成 push / schedule 等
  # schedule:
  #   - cron: '0 0 * * *'

jobs:
  delete:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Delete all files except .github
        run: |
          shopt -s extglob
          rm -rf !(.git|.github)
          git rm -rf --ignore-unmatch *
          git clean -fdx

      - name: Commit and push changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git commit -m "chore: delete all files" || echo "No changes to commit"
          git push
